# 复制为 .env 后修改。启动前执行：psql ... -f sql/init.sql

# --- 数据库（必填）---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pi
DB_USER=postgres
DB_PASSWORD=change-me
# DB_SCHEMA=aladdin

# --- 模型（Web 未保存配置时的兜底）---
LLM_PROVIDER=opencode-go
LLM_MODEL=mimo-v2.5
LLM_API_KEY=sk-替换为你的-key

# Web 保存模型配置到数据库时必填。生成：openssl rand -base64 32
LLM_CONFIG_ENCRYPTION_KEY=

# --- 可选 ---
# PORT=3002
# LLM_THINKING_LEVEL=medium
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL_ALIAS=网关侧模型名
